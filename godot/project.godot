; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="CRXCIBL3"
config/version="1.3.0"
run/main_scene="res://scenes/MainMenu.tscn"
run/max_fps=60
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/sprites/icon.png"

[autoload]

DialogueBox="*res://scenes/DialogueBox.tscn"
GameState="*res://autoload/GameState.gd"
M2MTransportLearner="*res://autoload/M2MTransportLearner.gd"
M2MMachineIdentity="*res://autoload/M2MMachineIdentity.gd"
M2MResilienceCore="*res://autoload/M2MResilienceCore.gd"
PermissionRationale="*res://autoload/PermissionRationale.gd"
CoopBluetooth="*res://autoload/CoopBluetooth.gd"
M2MSession="*res://autoload/M2MSession.gd"
CoopNetwork="*res://autoload/CoopNetwork.gd"
HeroDefinitions="*res://autoload/HeroDefinitions.gd"
HeroFactory="*res://autoload/HeroFactory.gd"
Stress="*res://autoload/Stress.gd"
SaveSystem="*res://autoload/SaveSystem.gd"
Recap="*res://autoload/Recap.gd"
CutsceneDirector="*res://autoload/CutsceneDirector.gd"
EnemyRegistry="*res://autoload/EnemyRegistry.gd"
Scarcity="*res://autoload/Scarcity.gd"
Injury="*res://autoload/Injury.gd"
Hideout="*res://autoload/Hideout.gd"
Morale="*res://autoload/Morale.gd"
Reputation="*res://autoload/Reputation.gd"
Alliance="*res://autoload/Alliance.gd"
DialogueIntensity="*res://autoload/DialogueIntensity.gd"
PermanentDeath="*res://autoload/PermanentDeath.gd"
Blame="*res://autoload/Blame.gd"
Bosses="*res://autoload/Bosses.gd"
Emperor="*res://autoload/Emperor.gd"
Epilogue="*res://autoload/Epilogue.gd"
RelationshipSystem="*res://autoload/RelationshipSystem.gd"
NPCManager="*res://autoload/NPCManager.gd"
SquadController="*res://autoload/SquadController.gd"
Inventory="*res://autoload/Inventory.gd"
QuestManager="*res://autoload/QuestManager.gd"
AndroidPlatform="*res://autoload/AndroidPlatform.gd"
ProcessDeathSnapshot="*res://autoload/ProcessDeathSnapshot.gd"
ControllerGlyphs="*res://autoload/ControllerGlyphs.gd"

[audio]

driver/output_latency=15
driver/enable_input=false

[display]

window/size/viewport_width=384
window/size/viewport_height=216
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="landscape"
window/vsync/vsync_mode=1

[internationalization]

locale/translations=PackedStringArray("res://translations/en.po", "res://translations/es.po", "res://translations/fr.po")

[input_devices]

buffering/agile_event_flushing=true
buffering/use_accumulated_input=false

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true
