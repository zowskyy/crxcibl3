[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/CoopLobbyScene.gd" id="1"]

[node name="CoopLobbyScene" type="Control"]
layout_mode=3
anchors_preset=15
anchor_right=1.0
anchor_bottom=1.0
script=ExtResource("1")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode=1
anchor_left=0.08
anchor_top=0.06
anchor_right=0.92
anchor_bottom=0.94
theme_override_constants/separation=8

[node name="TitleLabel" type="Label" parent="VBox"]
layout_mode=2
theme_override_font_sizes/font_size=20
text="Co-op Lobby"
horizontal_alignment=1

[node name="TransportLabel" type="Label" parent="VBox"]
layout_mode=2
theme_override_font_sizes/font_size=11
text="Transport: Wi-Fi"
horizontal_alignment=1
modulate=Color(0.7, 0.85, 1, 1)

[node name="StatusLabel" type="Label" parent="VBox"]
layout_mode=2
theme_override_font_sizes/font_size=10
text="Scan or host to find friends on the same Wi-Fi."
autowrap_mode=2
horizontal_alignment=1

[node name="HostButton" type="Button" parent="VBox"]
layout_mode=2
theme_override_font_sizes/font_size=13
text="Host Game"

[node name="ScanButton" type="Button" parent="VBox"]
layout_mode=2
theme_override_font_sizes/font_size=13
text="Scan Nearby"

[node name="NearbyLabel" type="Label" parent="VBox"]
layout_mode=2
theme_override_font_sizes/font_size=10
text="Nearby sessions:"

[node name="NearbyList" type="ItemList" parent="VBox"]
layout_mode=2
size_flags_vertical=3
theme_override_font_sizes/font_size=10

[node name="JoinRow" type="HBoxContainer" parent="VBox"]
layout_mode=2
theme_override_constants/separation=6

[node name="JoinIpField" type="LineEdit" parent="VBox/JoinRow"]
layout_mode=2
size_flags_horizontal=3
theme_override_font_sizes/font_size=11
placeholder_text="Host IP (e.g. 192.168.1.42)"

[node name="JoinButton" type="Button" parent="VBox/JoinRow"]
layout_mode=2
theme_override_font_sizes/font_size=12
text="Join"

[node name="BackButton" type="Button" parent="VBox"]
layout_mode=2
theme_override_font_sizes/font_size=11
text="← Main Menu"
